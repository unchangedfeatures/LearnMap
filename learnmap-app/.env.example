# LearnMap env example
# Copy this file to .env.local and fill values.
# Never commit real secrets.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI endpoint
# Can be either a base URL (we append /chat/completions) or the full /chat/completions URL.
AI_ENDPOINT_URL=
AI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_SMART=
